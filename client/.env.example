# client/.env — read by Vite at BUILD time (local `npm run dev` and the Docker
# build both pick it up automatically). Values are inlined into the JS bundle,
# so they are public by nature: never put a secret here.
#
# Changing these in Docker needs a rebuild, not a restart:
#   docker compose up -d --build client

VITE_AZURE_CLIENT_ID=
VITE_AZURE_TENANT_ID=
