# Copy to .env on the server and fill in real values. Never commit .env.
# Read by docker compose (for build args / interpolation) and passed to the
# server container via env_file.

# ---- Where this app is reachable (used for CORS and the Microsoft redirect) ----
FRONTEND_URL=https://docs.example.com
MICROSOFT_REDIRECT_URI=https://docs.example.com/auth/callback

# Host port the nginx container binds on 127.0.0.1. Front it with TLS.
HTTP_PORT=8080

# ---- Database ----
# Leave as-is to use the bundled mongo container; or paste an Atlas SRV string.
MONGODB_URI=mongodb://mongo:27017/docproject
# Only needed if the host cannot resolve Atlas SRV records.
# MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1

# ---- Auth ----
ADMIN_EMAIL=
ADMIN_PASSWORD=
# openssl rand -hex 32
JWT_SECRET=

# ---- Azure AD ----
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_SECRET=
# Same two ids, inlined into the frontend bundle at BUILD time.
# Change them => rebuild the client image, not just restart it.
VITE_AZURE_CLIENT_ID=
VITE_AZURE_TENANT_ID=

# ---- Internal API (server-to-server companion app) ----
INTERNAL_API_KEY=
INTERNAL_API_ALLOWED_IPS=
INTERNAL_API_ALLOWED_ORIGINS=
INTERNAL_API_PUBLIC=false

# ---- Optional tuning ----
# RATE_LIMIT_GLOBAL=200
# RATE_LIMIT_UPLOAD=120
# RATE_LIMIT_AUTH=20
# API_BODY_LIMIT=50mb
