# server/.env — the same file for local dev and for Docker (compose passes it
# in with env_file). Gitignored; copy this template and fill it in.

# ---- Database (required) ----
# Docker with the bundled mongo container -> use the service name, NOT localhost:
MONGODB_URI=mongodb://mongo:27017/docproject
# Local dev against your own mongo:  mongodb://localhost:27017/docproject
# Atlas:                             mongodb+srv://user:pass@cluster.mongodb.net/docproject
# Only if the host cannot resolve Atlas SRV records:
# MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1

# ---- Auth (JWT_SECRET required) ----
# openssl rand -hex 32
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Public URL: must match exactly, no trailing slash, or CORS blocks it ----
FRONTEND_URL=https://docs.example.com
MICROSOFT_REDIRECT_URI=https://docs.example.com/auth/callback

# ---- Azure AD ----
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_SECRET=

# ---- Internal API (server-to-server companion app) ----
# The key is ALWAYS required (no anonymous mode). Optionally restrict callers
# to specific origins (browser calls) and/or IPs (server-to-server).
INTERNAL_API_KEY=
INTERNAL_API_ALLOWED_IPS=
INTERNAL_API_ALLOWED_ORIGINS=

# ---- Optional ----
# PORT is forced to 5000 inside Docker; this only affects local dev.
PORT=5001
# RATE_LIMIT_GLOBAL=200
# RATE_LIMIT_UPLOAD=120
# RATE_LIMIT_AUTH=20
# API_BODY_LIMIT=50mb
